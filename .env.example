MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/food_rescue
JWT_SECRET=your-super-secret-jwt-key-here
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
CORS_ORIGINS=http://localhost:3000,http://localhost:5500
FLASK_ENV=development

# --- Dedicated administrator account (bootstrapped at startup) -------------
# The admin console (admin.html) requires these separate credentials.
ADMIN_EMAIL=adminfood@gmail.com
ADMIN_PASSWORD=food135

# --- Password reset emails via Brevo (https://www.brevo.com) ---------------
# Create a free account, then API key from SMTP & API settings. Without a key
# (local development) the reset code is returned in the API response instead.
BREVO_API_KEY=
SENDER_EMAIL=no-reply@yourdomain.com
SENDER_NAME=FoodRescue

# --- Data-science layer (all optional) ---
# Comma-separated emails allowed to call /api/run-audit. Empty = any
# authenticated user (development only — always set this in production).
ADMIN_EMAILS=vivekpatidar183@gmail.com
# Volunteer fleet size split across zones by /api/predict-surplus.
DS_FLEET_SIZE=20
# Override the city center for the zone grid ("lng,lat"). Defaults to the
# first registered user's location.
CITY_CENTER=
